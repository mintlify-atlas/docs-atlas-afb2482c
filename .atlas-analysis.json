  "keyFeatures": [
    "Next.js-powered static site with incremental static regeneration",
    "MDX content system for rich, interactive documentation pages",
    "15+ language internationalization via Crowdin and next-intl",
    "Dual-package component architecture: @node-core/ui-components + site-specific components",
    "Tailwind CSS + CSS Modules hybrid styling system",
    "Storybook integration for component development and visual regression testing",
    "Custom page rendering system via dynamic [...path].tsx route",
    "Vercel and Cloudflare multi-target build and deployment pipeline",
    "Node.js release data integration and automated release blog post generation",
    "Orama-powered full-text search across site content"
  ],
  "publicApiSurface": [
    "@node-core/ui-components — published npm package of reusable React UI components",
    "apps/site/pages/en/ — MDX/Markdown content pages (Learn, Blog, About, Download)",
    "apps/site/navigation.json — site navigation configuration",
    "apps/site/next-data/ — build-time data fetching for releases, blog, and RSS",
    "apps/site/layouts/ — page layout templates mapped via withLayout.tsx",
    "apps/site/components/ — Next.js-specific site components (NavBar, Footer, Sidebar, etc.)",
    "packages/rehype-shiki — custom Rehype plugin for Shiki syntax highlighting",
    "packages/remark-lint — custom Remark lint rules for content quality",
    "apps/site/scripts/ — CLI utilities including release post generator",
    "pnpm dev / pnpm build / pnpm deploy — development and build CLI commands"
  ]
